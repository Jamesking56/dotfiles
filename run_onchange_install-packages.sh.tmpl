#!/bin/bash
set -euo pipefail

# NOTE: If Ollama systemd service uses /usr/local/bin instead of /usr/bin,
# create override: sudo mkdir -p /etc/systemd/system/ollama.service.d
# sudo tee /etc/systemd/system/ollama.service.d/override.conf <<'EOF'
# [Service]
# ExecStart=
# ExecStart=/usr/bin/ollama serve
# EOF
# sudo systemctl daemon-reload && sudo systemctl restart ollama

# Cache sudo credentials once and refresh in the background so the script
# doesn't prompt repeatedly. Skips prompting entirely if a credential is
# already cached. Uses sudo -n (non-interactive) so it won't conflict with
# omarchy's own keepalive in interactive commands.
sudo -n -v 2>/dev/null || sudo -v
sudo_keepalive() { while true; do sudo -n true; sleep 60; done; }
sudo_keepalive &
SUDO_KEEPALIVE_PID=$!

# -----------------------------
# Parallel job helpers
# -----------------------------
# AUR packages build with makepkg. /etc/makepkg.conf has MAKEFLAGS commented
# out, which means each build runs single-threaded. Use all cores by default,
# and give each parallel build an equal share.
NCORES=$(nproc)
NCORES_PER_BUILD=$((NCORES / 3))
[[ $NCORES_PER_BUILD -lt 1 ]] && NCORES_PER_BUILD=1
export MAKEFLAGS="-j${NCORES}"

# Background jobs log to files so parallel output doesn't interleave.
LOG_DIR=$(mktemp -d /tmp/install-packages.XXXXXX)
echo "Parallel job logs: $LOG_DIR"

BACKGROUND_PIDS=()
BACKGROUND_NAMES=()
NET_PIDS=()
NET_NAMES=()

# Run a function as a background job with optional per-job MAKEFLAGS override.
background_job() {
  local name="$1"
  local makeflags="$2"
  shift 2
  (
    if [[ -n "$makeflags" ]]; then
      export MAKEFLAGS="$makeflags"
    fi
    "$@"
  ) >"$LOG_DIR/$name.log" 2>&1 &
  BACKGROUND_PIDS+=($!)
  BACKGROUND_NAMES+=("$name")
}

# Non-package network/independent jobs, waited on together at the end.
net_job() {
  background_job "$@"
  NET_PIDS+=("${BACKGROUND_PIDS[-1]}")
  NET_NAMES+=("${BACKGROUND_NAMES[-1]}")
}

cleanup() {
  kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
  for pid in "${BACKGROUND_PIDS[@]:-}"; do
    kill "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT

install_sshm() {
  echo "Installing sshm..."
  curl -sSL https://raw.githubusercontent.com/Gu1llaum-3/sshm/main/install/unix.sh | bash
}

import_ssh_keys() {
  echo "Importing authorised SSH keys..."
  rm -f ~/.ssh/authorized_keys
  ssh-import-id gh:Jamesking56
}

setup_composer() {
  echo "Installing global Composer packages declared in composer.json..."
  echo "  Testing DNS resolution..."
  if ! getent hosts repo.packagist.org >/dev/null 2>&1; then
    echo "  DNS resolution failed -- restarting systemd-resolved..."
    sudo systemctl restart systemd-resolved
    sleep 2
    if ! getent hosts repo.packagist.org >/dev/null 2>&1; then
      echo "  ERROR: DNS still failing after restart. Trying alternate resolv.conf..."
      echo "nameserver 1.1.1.1" | sudo tee /etc/resolv.conf > /dev/null
    fi
  fi
  echo "  DNS OK"
  /usr/bin/php /usr/bin/composer global update --no-interaction
}

setup_lerd() {
  echo "Setting up lerd (local PHP dev environment)..."
  if ! command -v lerd; then
    curl -fsSL https://raw.githubusercontent.com/geodro/lerd/main/install.sh | bash
  else
    lerd update
  fi
  echo "Lerd MCP is registered per-agent via their own configs, not globally."
}

install_skills() {
  echo "Installing agent skills..."
  local repo skills
  for repo in "${!SKILLS_INSTALLS[@]}"; do
    skills="${SKILLS_INSTALLS[$repo]}"
    echo "  npx skills add '$repo' ($skills)..."
    npx skills add "$repo" --skill "$skills" --agent $SKILLS_AGENTS --global --yes >/dev/null 2>&1 || echo "  WARNING: Failed to install from $repo"
  done
}

cleanup_docker_containers() {
  local container
  for container in mariadb11 postgres18 mailhog; do
    if [ -n "$(docker ps -a -q -f name=$container 2>/dev/null)" ]; then
      echo "  Removing standalone $container (now managed by Lerd)..."
      docker stop "$container" 2>/dev/null || true
      docker rm -v "$container" 2>/dev/null || true
    fi
  done
}

setup_pipx() {
  echo "Setting up pipx/mycli..."
  python -m pip uninstall -y mycli 2>/dev/null || true
  pipx ensurepath
  pipx reinstall mycli || pipx install mycli
}

install_php_version() {
  local ver="$1"
  local failed=0
  local pkgs=("php${ver}")
  local ext
  for ext in "${SAFE_EXTENSIONS[@]}"; do
    pkgs+=("php${ver}-${ext}")
  done

  echo "==> Installing/upgrading PHP $ver + safe extensions..."
  if ! omarchy pkg aur add "${pkgs[@]}"; then
    echo "Warning: Some PHP $ver packages failed."
    failed=1
  fi

  for ext in "${TRICKY_EXTENSIONS[@]}"; do
    echo "Installing tricky extension php${ver}-${ext}..."
    omarchy pkg aur add "php${ver}-${ext}" || {
      echo "Failed to install php${ver}-${ext}. Please install manually."
    }
  done

  if [[ $ver == "84" ]]; then
    # redis via PECL for PHP 8.4 (if AUR package is missing)
    if [ -d "/etc/php84" ] && [ ! -f "/etc/php84/conf.d/redis.ini" ]; then
      echo "Installing redis via PECL for PHP 8.4..."
      yes '' | sudo pecl84 install --soft redis 2>/dev/null || true
      echo "extension=redis.so" | sudo tee /etc/php84/conf.d/redis.ini > /dev/null
    fi
  fi

  return $failed
}

build_pcov() {
  local ver="$1"
  local dir="$2"
  echo "==> Building pcov for PHP $ver..."
  cd "$dir"
  make clean 2>/dev/null || true
  "phpize${ver}" >/dev/null 2>&1 || { echo "phpize${ver} failed"; return 1; }
  ./configure --with-php-config="/usr/bin/php-config${ver}" >/dev/null 2>&1 || { echo "configure failed for PHP $ver"; return 1; }
  make || { echo "make failed for PHP $ver"; return 1; }
  sudo make install || { echo "make install failed for PHP $ver"; return 1; }
  if [ ! -f "/etc/php${ver}/conf.d/pcov.ini" ]; then
    printf "extension=pcov.so\npcov.enabled=1\n" | sudo tee "/etc/php${ver}/conf.d/pcov.ini" > /dev/null
  fi
}

# -----------------------------
# Remove unwanted packages
# -----------------------------
REMOVE_PACKAGES=(
  1password
  1password-cli
  alacritty
  cloudfleet-cli
  hcloud
  helm
  kubectl
  kubectl-cnpg
  lens-bin
  mattermost-desktop-bin
  signal-desktop
  spotify
  typora
  xournalpp
)

omarchy pkg drop "${REMOVE_PACKAGES[@]}"

# -----------------------------
# Remove unwanted web apps
# -----------------------------
REMOVE_WEB_APPS=(
  Basecamp
  Discord
  Figma
  Fizzy
  HEY
)

for app in "${REMOVE_WEB_APPS[@]}"; do
  omarchy-webapp-remove "$app"
done

# -----------------------------
# Ensure DNS is configured before any network-dependent operations
# -----------------------------
sudo systemctl enable systemd-resolved 2>/dev/null || true
if ! pidof systemd-resolved &>/dev/null; then
  sudo systemctl start systemd-resolved
  sleep 1
fi
sudo mkdir -p /etc/systemd/resolved.conf.d
sudo rm -f /etc/systemd/resolved.conf.d/lerd.conf /etc/systemd/resolved.conf.d/10-cloudflare.conf
sudo tee /etc/systemd/resolved.conf.d/lerd-dns.conf > /dev/null <<'EOF'
[Resolve]
DNS=1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com
DNS=127.0.0.1:5300
Domains=~test
EOF
sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

# -----------------------------
# Lerd service hostnames (so host PHP can reach podman containers)
# -----------------------------
if ! grep -q "lerd-mysql" /etc/hosts; then
  echo "# Lerd services (podman containers exposed on localhost)
127.0.0.1 lerd-mysql lerd-redis lerd-mailpit lerd-meilisearch lerd-postgres lerd-rustfs" | sudo tee -a /etc/hosts > /dev/null
fi

# -----------------------------
# Enable SSH server over LAN
# -----------------------------
sudo ufw allow from 192.168.0.0/24 to any port 22
sudo systemctl enable sshd
sudo systemctl start sshd

# -----------------------------
# Background tasks that only need a base system
# -----------------------------
SKILLS_AGENTS="claude-code opencode"
declare -A SKILLS_INSTALLS=(
  ["https://github.com/vercel-labs/skills"]="find-skills"
  ["https://github.com/mattpocock/skills"]="*"
  ["https://github.com/anthropics/skills"]="frontend-design"
  ["https://github.com/vercel-labs/agent-browser"]="agent-browser"
  ["https://github.com/addyosmani/web-quality-skills"]="accessibility"
  ["https://github.com/typefully/agent-skills"]="typefully"
)

net_job "skills" "" install_skills
net_job "sshm" "" install_sshm

# setup_lerd runs on the main thread (not a background job) because
# `lerd update` sometimes prompts for input.
setup_lerd

# -----------------------------
# Core system packages
# -----------------------------
PACMAN_PKGS=(
  age
  bind
  bitwarden
  bitwarden-cli
  chromium
  composer
  docker
  docker-buildx
  docker-compose
  dosfstools
  ghostty
  git
  graphviz
  mariadb-clients
  mc
  ncdu
  ntfs-3g
  pgcli
  php
  php-fpm
  php-gd
  php-igbinary
  php-imagick
  php-pgsql
  php-redis
  php-sodium
  php-sqlite
  podman
  prettyping
  python-distro
  python-pipx
  python-setuptools
  python-setuptools-scm
  rclone
  rsync
  scrcpy
  tailscale
  tmux
  trash-cli
  vorta
  wp-cli
  xsel
  yq
  zed
)

YAY_PKGS=(
  antigen
  brave-bin
  bruno-bin
  cheese
  downgrade
  hyprmon-bin
  jetbrains-toolbox
  laravel-moat
  noti
  opencode-desktop-bin
  rdap-bin
  ssh-import-id
  stripe-cli-bin
  vesktop-bin
  zen-browser-bin
  zsh
)

# Ensure mise-managed Python has AUR build dependencies
# mise Python takes PATH precedence over system Python, but AUR makedepends
# (python-installer, python-setuptools-scm, etc.) only install to system Python.
# Without these, python -m build and python -m installer fail during makepkg.
PYTHON_BIN=$(command -v python 2>/dev/null || true)
if echo "$PYTHON_BIN" | grep -q "mise"; then
  echo "mise-managed Python detected at $PYTHON_BIN; ensuring AUR build deps are installed..."
  pip install --quiet installer setuptools-scm 2>/dev/null || true
fi

echo "Installing core packages..."
omarchy pkg add "${PACMAN_PKGS[@]}"
omarchy pkg aur add "${YAY_PKGS[@]}"

# Enable system PHP extensions (main php package bundles .so files but they need ini files)
for ext in bcmath gd iconv intl pdo_mysql sockets sodium; do
  if [ ! -f "/etc/php/conf.d/${ext}.ini" ] && [ -f "/usr/lib/php/modules/${ext}.so" ]; then
    echo "extension=${ext}.so" | sudo tee "/etc/php/conf.d/${ext}.ini" > /dev/null
  fi
done

# Enable pdo_sqlite and sqlite3 (from php-sqlite package)
if [ ! -f "/etc/php/conf.d/sqlite.ini" ]; then
  printf "extension=pdo_sqlite.so\nextension=sqlite3.so\n" | sudo tee /etc/php/conf.d/sqlite.ini > /dev/null
fi

# Enable redis for system PHP
if [ ! -f "/etc/php/conf.d/redis.ini" ]; then
  echo "extension=redis.so" | sudo tee /etc/php/conf.d/redis.ini > /dev/null
fi

# Enable igbinary for system PHP (ini exists but extension may be commented)
sudo sed -i 's/^;extension=igbinary/extension=igbinary/' /etc/php/conf.d/igbinary.ini 2>/dev/null || true

# Enable imagick for system PHP (ini exists but extension may be commented)
sudo sed -i 's/^; extension = imagick/extension=imagick.so/' /etc/php/conf.d/imagick.ini 2>/dev/null || true

# Remove Brave theming installed by Omarchy
sudo rm -f /etc/brave/policies/managed/color.json

# -----------------------------
# Background tasks that need installed packages
# -----------------------------
net_job "composer" "" setup_composer
net_job "ssh-import" "" import_ssh_keys
net_job "pipx" "" setup_pipx
net_job "docker" "" cleanup_docker_containers

# -----------------------------
# PHP Versions and Extensions
# -----------------------------
PHP_VERSIONS=(84 83 82)

# Extensions safe to bulk-install
SAFE_EXTENSIONS=(bcmath cli curl dom exif fileinfo fpm gd iconv intl mbstring mysql openssl pcntl pdo pecl pgsql phar posix simplexml sqlite sockets sodium tokenizer xml xmlreader xmlwriter zip)

# Extensions that often fail and need manual installation
TRICKY_EXTENSIONS=(redis xdebug)

echo "Upgrading/installing PHP versions and extensions per version..."
echo "  Building PHP ${PHP_VERSIONS[*]} in parallel (each build uses -j${NCORES_PER_BUILD})."

PHP_PIDS=()
PHP_LABELS=()
for ver in "${PHP_VERSIONS[@]}"; do
  background_job "php-$ver" "-j${NCORES_PER_BUILD}" install_php_version "$ver"
  PHP_PIDS+=("${BACKGROUND_PIDS[-1]}")
  PHP_LABELS+=("php-$ver")
done

for i in "${!PHP_PIDS[@]}"; do
  if wait "${PHP_PIDS[$i]}"; then
    echo "  PHP ${PHP_LABELS[$i]#php-}: OK"
  else
    echo "  PHP ${PHP_LABELS[$i]#php-}: FAILED (see $LOG_DIR/${PHP_LABELS[$i]}.log)"
    tail -n 20 "$LOG_DIR/${PHP_LABELS[$i]}.log" 2>/dev/null | sed 's/^/    /'
  fi
done

# Build and install pcov for all PHP versions (parallel across versions)
echo "Building pcov for all PHP versions..."
PCOV_TMP=$(mktemp -d)
git clone https://github.com/krakjoe/pcov.git "$PCOV_TMP/pcov"
PCOV_PIDS=()
for ver in "${PHP_VERSIONS[@]}"; do
  cp -a "$PCOV_TMP/pcov" "$PCOV_TMP/pcov-$ver"
  background_job "pcov-$ver" "-j${NCORES_PER_BUILD}" build_pcov "$ver" "$PCOV_TMP/pcov-$ver"
  PCOV_PIDS+=("${BACKGROUND_PIDS[-1]}")
done

for i in "${!PCOV_PIDS[@]}"; do
  if wait "${PCOV_PIDS[$i]}"; then
    echo "  pcov ${PHP_VERSIONS[$i]}: OK"
  else
    echo "  pcov ${PHP_VERSIONS[$i]}: FAILED (see $LOG_DIR/pcov-${PHP_VERSIONS[$i]}.log)"
    tail -n 20 "$LOG_DIR/pcov-${PHP_VERSIONS[$i]}.log" 2>/dev/null | sed 's/^/    /'
  fi
done
rm -rf "$PCOV_TMP"

# -----------------------------
# Wait for remaining background tasks
# -----------------------------
echo "Waiting for remaining background tasks..."
for i in "${!NET_PIDS[@]}"; do
  if wait "${NET_PIDS[$i]}"; then
    echo "  ${NET_NAMES[$i]}: OK"
  else
    echo "  ${NET_NAMES[$i]}: FAILED (see $LOG_DIR/${NET_NAMES[$i]}.log)"
    tail -n 15 "$LOG_DIR/${NET_NAMES[$i]}.log" 2>/dev/null | sed 's/^/    /'
  fi
done

echo "  Updating all global skills..."
npx skills update --global --yes >/dev/null 2>&1 || echo "  WARNING: Failed to update skills"

# -----------------------------
# Update omarchy skill
# -----------------------------
if [ -d ~/.local/share/omarchy/default/omarchy-skill ]; then
  rm -rf ~/.claude/skills/omarchy
  cp -r ~/.local/share/omarchy/default/omarchy-skill ~/.claude/skills/omarchy
fi

# For systemd-networkd systems: prefer ethernet over WiFi, keep DHCP DNS for regular queries
sudo tee /etc/systemd/network/20-wlan.network > /dev/null <<'NETEOF'
[Match]
Name=wl*

[Network]
DHCP=yes
DNS=127.0.0.1:5300
Domains=~test

[DHCPv4]
RouteMetric=600

[IPv6AcceptRA]
RouteMetric=600
NETEOF

# Clean up old valet-linux completely
sudo systemctl stop valet-dns 2>/dev/null || true
sudo systemctl disable valet-dns 2>/dev/null || true
systemctl --user stop valet-dns 2>/dev/null || true
systemctl --user disable valet-dns 2>/dev/null || true
sudo rm -f /etc/dnsmasq.d/valet.conf /etc/dnsmasq.d/valet-upstream.conf /etc/dnsmasq.d/tailscale.conf
sudo rm -f /etc/systemd/system/valet-dns.service /etc/systemd/system/valet-dns.service.d/override.conf 2>/dev/null || true
sudo rm -f /etc/sudoers.d/valet
sudo rm -f /usr/local/bin/valet
sudo rm -rf /etc/nginx/valet /usr/local/etc/nginx/valet 2>/dev/null || true
sudo chattr -R -i /opt/valet-linux 2>/dev/null || true
sudo rm -rf /opt/valet-linux
sudo rm -f /etc/NetworkManager/conf.d/lerd.conf /etc/NetworkManager/dnsmasq.d/lerd.conf
rm -rf "$HOME/.config/valet" 2>/dev/null || true

# -----------------------------
# Git repositories
# -----------------------------
declare -A GIT_REPOS=(
)

echo "Cloning/updating git repositories..."
for repo_dir in "${!GIT_REPOS[@]}"; do
  repo_url="${GIT_REPOS[$repo_dir]}"
  if [ ! -d "$repo_dir" ]; then
    echo "  Cloning $repo_url -> $repo_dir"
    git clone "$repo_url" "$repo_dir"
  elif [ -d "$repo_dir/.git" ]; then
    echo "  Updating $repo_dir"
    (cd "$repo_dir" && git pull)
  fi
done

# -----------------------------
# Clean up old ponytail checkout (now managed via opencode plugin)
# -----------------------------
if [ -d "$HOME/.local/share/ponytail" ]; then
  echo "  Removing old ponytail checkout (now managed via opencode plugin)..."
  rm -rf "$HOME/.local/share/ponytail"
fi

{{ if .is_desktop -}}
# -----------------------------
# Sync AUR votes
# -----------------------------
aur-sync-vote --remember --explicit || echo "WARNING: aur-sync-vote failed (known issue with php82-bz2 metadata)"
{{ end -}}

# -----------------------------
# Finish
# -----------------------------
omarchy-show-done
