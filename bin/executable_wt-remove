#!/bin/bash
set -euo pipefail

worktree_dir=$(pwd)
worktree_name=$(basename "$worktree_dir")

main_dir=$(git worktree list | awk 'NR==1{print $1}')

if [ ! -d "$main_dir" ]; then
    echo "Error: Could not determine main project directory" >&2
    exit 1
fi

if [ "$worktree_dir" = "$main_dir" ]; then
    echo "Error: Refusing to remove the main project directory. Are you in a worktree?" >&2
    exit 1
fi

db_user=$(grep "^DB_USERNAME=" "$main_dir/.env" 2>/dev/null | tail -1 | cut -d= -f2-)
db_pass=$(grep "^DB_PASSWORD=" "$main_dir/.env" 2>/dev/null | tail -1 | cut -d= -f2-)
db_name=$(grep "^DB_DATABASE=" "$worktree_dir/.env" 2>/dev/null | tail -1 | cut -d= -f2-)
main_db=$(grep "^DB_DATABASE=" "$main_dir/.env" 2>/dev/null | tail -1 | cut -d= -f2-)

if [ -n "$db_user" ] && [ -n "$db_pass" ] && [ -n "$db_name" ] && [ "$db_name" != "$main_db" ]; then
    echo "Dropping isolated database: $db_name"
    podman exec -e MYSQL_PWD="$db_pass" lerd-mysql mysql -u "$db_user" -e "DROP DATABASE IF EXISTS \`${db_name}\`" 2>/dev/null || true
    podman exec -e MYSQL_PWD="$db_pass" lerd-mysql mysql -u "$db_user" -e "DROP DATABASE IF EXISTS \`${db_name}_testing\`" 2>/dev/null || true
fi

cd "$main_dir"

echo "Removing worktree: $worktree_name"
lerd worktree remove --force "$worktree_dir"

exec $SHELL
