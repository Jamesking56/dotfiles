# File system
if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

alias ff="fzf --preview 'bat --style=numbers --color=always {}'"

if command -v zoxide &> /dev/null; then
  alias cd="zd"
  zd() {
    if [ $# -eq 0 ]; then
      builtin cd ~ && return
    elif [ -d "$1" ]; then
      builtin cd "$1"
    else
      z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
    fi
  }
fi

open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

alias rm='trash'

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias l='ls -lha'
alias ls='eza -lh --group-directories-first --icons=auto'

# Git
alias gwip='git add -A; git rm $(git ls-files --deleted) 2> /dev/null; git commit --no-verify -m "[WIP] $(curl --silent --fail https://whatthecommit.com/index.txt)"'
alias gwipa='git commit --amend --no-verify -m "[WIP] $(curl --silent --fail https://whatthecommit.com/index.txt)"'
alias gunwip='git rev-list --max-count=1 --format="%s" HEAD | grep -q "\[WIP]" && git reset HEAD~1'

# GitHub
alias clone='gh repo clone'
alias open-repo='gh repo view -w'
alias trigger-run='gh workflow run'
alias watch-run='gh run watch'
alias view-run='gh run view -w'

