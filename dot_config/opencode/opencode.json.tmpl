{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "bash": {
      "git push": "ask"
    }
  },
  "plugin": ["@dietrichgebert/ponytail"],
  "lsp": {
    "laravel-lsp": {
      "command": ["laravel-lsp"],
      "extensions": [".php", ".blade.php"]
    }
  },
  "mcp": {
    "tailkit": {
      "type": "remote",
      "url": "https://tailkit.com/mcp"
    },
    "lerd": {
      "type": "local",
      "command": ["lerd", "mcp"]
    }
  },
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{ if .is_desktop }}http://localhost:11434/v1{{ else }}http://james-desktop.tail1d05e.ts.net:11434/v1{{ end }}"
      },
      "models": {
        "qwen3.5:9b": {
          "_launch": {{ .is_desktop }},
          "name": "Qwen3.5 9B"
        },
        "qwen3-coder:30b": {
          "_launch": {{ .is_desktop }},
          "name": "Qwen3 Coder 30B"
        },
        "gpt-oss:20b": {
          "_launch": {{ .is_desktop }},
          "name": "GPT-OSS 20B"
        }
      }
    }
  }
}
