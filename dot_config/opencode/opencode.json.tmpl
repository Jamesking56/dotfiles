{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["@dietrichgeber/ponytail"],
  "mcp": {
    "tailkit": {
      "type": "remote",
      "url": "https://tailkit.com/mcp"
    }
  },
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{ if .is_desktop }}http://localhost:11434/v1{{ else }}http://james-desktop.tail1d05e.ts.net:11434/v1{{ end }}"
      },
      "models": {
        "qwen2.5-coder:14b-8k": {
          "_launch": {{ .is_desktop }},
          "name": "Qwen2.5-Coder 14B"
        }
      }
    }
  }
}
