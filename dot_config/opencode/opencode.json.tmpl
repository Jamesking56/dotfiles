{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "bash": {
      "git push": "ask"
    }
  },
  "plugin": ["@dietrichgebert/ponytail"],
  "lsp": {
    "laravel-lsp": {
      "command": ["laravel-lsp"],
      "extensions": [".php", ".blade.php"]
    }
  },
  "mcp": {
    "tailkit": {
      "type": "remote",
      "url": "https://tailkit.com/mcp"
    },
    "lerd": {
      "type": "local",
      "command": ["lerd", "mcp"]
    }
  },
  "provider": {
    "opencode": {
      "blacklist": [
        "gpt-5",
        "gpt-5-codex",
        "gpt-5-nano",
        "gpt-5.1",
        "gpt-5.1-codex",
        "gpt-5.1-codex-max",
        "gpt-5.1-codex-mini",
        "gpt-5.2",
        "gpt-5.2-codex",
        "gpt-5.3-codex",
        "gpt-5.3-codex-spark",
        "gpt-5.4",
        "gpt-5.4-mini",
        "gpt-5.4-nano",
        "gpt-5.4-pro",
        "gpt-5.5",
        "gpt-5.5-pro",
        "gpt-5.6-luna",
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-6-astra"
      ]
    },
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{ if .is_desktop }}http://localhost:11434/v1{{ else }}http://james-desktop.tail1d05e.ts.net:11434/v1{{ end }}"
      },
      "models": {
        "qwen3.5:9b": {
          "_launch": {{ .is_desktop }},
          "name": "Qwen3.5 9B"
        },
        "qwen3-coder:30b": {
          "_launch": {{ .is_desktop }},
          "name": "Qwen3 Coder 30B"
        },
        "gpt-oss:20b": {
          "_launch": {{ .is_desktop }},
          "name": "GPT-OSS 20B"
        }
      }
    }
  }
}
